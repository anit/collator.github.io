  <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline poster="/assets/video/hero-bg-poster.jpg">
    <source src="/assets/video/hero-bg.mp4" type="video/mp4">
  </video>

  <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-8 w-full pt-14">

    <div class="grid grid-cols-1 items-center md:grid-cols-2 md:gap-16 md:py-20">

      <!-- Text -->
      <div class="py-10 md:pt-0 md:pb-0">
        <h1 class="font-serif font-normal text-white leading-[1.08] text-[2.75rem] md:text-[3.75rem] mb-16 md:mb-24">One vault.<br>Your entire<br>estate.</h1>

        {% set hideCaption = true %}
        {% include "partials/download-buttons.njk" %}
      </div>

      <!-- App preview -->
      <div class="hidden md:flex items-center justify-center">
        <div class="w-[260px] aspect-[9/19.5] rounded-[40px] border-2 border-white/10 bg-white/[.03] overflow-hidden opacity-30 hover:opacity-100 transition-opacity duration-500">
          <video class="block w-full h-full object-cover rounded-[38px]" autoplay muted loop playsinline poster="/assets/video/hero-demo-poster.jpg">
            <source src="/assets/video/hero-demo.mp4" type="video/mp4">
          </video>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Problem -->
<section class="bg-canvas py-20 px-6 md:px-8">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">
    <div>
      <h2 class="font-serif font-normal text-[2.25rem] leading-[1.15] mb-6 text-ink">Everything important,<br>scattered everywhere.</h2>
      <p class="text-dim text-[1.0625rem] leading-relaxed opacity-70">Wills, policies, property papers and bank accounts sit in different drawers, apps and heads. Most families discover the chaos only when they need answers most.</p>
    </div>
    <div>
      <div class="pb-6 border-b-2 border-dashed border-inset">
        <p class="font-serif font-normal text-[3rem] leading-none text-ink"><a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2244475&reg=3&lang=1" target="_blank" rel="noopener" class="hover:text-saffron-deep transition-colors">&#8377;73,000<br>crore</a></p>
        <p class="text-muted text-sm mt-2 leading-snug"><a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2244475&reg=3&lang=1" target="_blank" rel="noopener" class="hover:text-saffron-deep transition-colors underline decoration-dotted underline-offset-4">sitting unclaimed in bank deposits, insurance and mutual funds.</a></p>
      </div>
      <div class="pt-6">
        <p class="font-serif font-normal text-[3rem] leading-none text-ink"><a href="https://cleartax.in/s/succession-certificate-format" target="_blank" rel="noopener" class="hover:text-saffron-deep transition-colors">3 to 6<br>months</a></p>
        <p class="text-muted text-sm mt-2 leading-snug"><a href="https://cleartax.in/s/succession-certificate-format" target="_blank" rel="noopener" class="hover:text-saffron-deep transition-colors underline decoration-dotted underline-offset-4">for a succession certificate when no nominee was named.</a></p>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="bg-tint border-y border-hair py-20 px-6 md:px-8">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-serif font-normal text-[2.25rem] leading-[1.15] mb-12 text-ink">Organised the way you think.</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">

      <div class="bg-card border border-hair rounded-[14px] p-5 shadow-card">
        <div class="w-9 h-9 border border-hair rounded-[8px] flex items-center justify-center mb-4 text-muted">
          {% icon "file-text", "w-[18px] h-[18px]" %}
        </div>
        <h3 class="font-semibold text-[.875rem] text-ink mb-2">Documents and IDs</h3>
        <p class="text-muted text-[.8125rem] leading-relaxed">Aadhaar, PAN, passport, policies, deeds, wills.</p>
      </div>

      <div class="bg-card border border-hair rounded-[14px] p-5 shadow-card">
        <div class="w-9 h-9 border border-hair rounded-[8px] flex items-center justify-center mb-4 text-muted">
          {% icon "landmark", "w-[18px] h-[18px]" %}
        </div>
        <h3 class="font-semibold text-[.875rem] text-ink mb-2">Assets and investments</h3>
        <p class="text-muted text-[.8125rem] leading-relaxed">Property, vehicles, deposits, mutual funds, PPF.</p>
      </div>

      <div class="bg-card border border-hair rounded-[14px] p-5 shadow-card">
        <div class="w-9 h-9 border border-hair rounded-[8px] flex items-center justify-center mb-4 text-muted">
          {% icon "users", "w-[18px] h-[18px]" %}
        </div>
        <h3 class="font-semibold text-[.875rem] text-ink mb-2">People and advisors</h3>
        <p class="text-muted text-[.8125rem] leading-relaxed">Family, and the doctor, CA, lawyer who help.</p>
      </div>

      <div class="bg-card border border-hair rounded-[14px] p-5 shadow-card">
        <div class="w-9 h-9 border border-hair rounded-[8px] flex items-center justify-center mb-4 text-muted">
          {% icon "lock", "w-[18px] h-[18px]" %}
        </div>
        <h3 class="font-semibold text-[.875rem] text-ink mb-2">Custody</h3>
        <p class="text-muted text-[.8125rem] leading-relaxed">Where every physical original is kept.</p>
      </div>

      <div class="bg-card border border-hair rounded-[14px] p-5 shadow-card">
        <div class="w-9 h-9 border border-hair rounded-[8px] flex items-center justify-center mb-4 text-muted">
          {% icon "share-2", "w-[18px] h-[18px]" %}
        </div>
        <h3 class="font-semibold text-[.875rem] text-ink mb-2">Succession</h3>
        <p class="text-muted text-[.8125rem] leading-relaxed">Wills, nominees, and the gaps between them.</p>
      </div>

    </div>
  </div>
</section>

