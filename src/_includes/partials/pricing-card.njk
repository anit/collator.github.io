    <span class="text-[2rem] font-normal tabular-nums text-ink">&#8377;{{ site.price }}</span>
  </div>
  <ul class="space-y-3 mb-8">
    <li class="flex items-center gap-3 text-[.9375rem] text-dim">
      {% icon "check", "w-4 h-4 text-marigold-deep shrink-0" %}
