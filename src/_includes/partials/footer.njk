<footer id="site-footer" class="bg-night border-t border-night-line py-14 px-6 md:px-8">
  <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-5 gap-10">
    <div class="col-span-2 md:col-span-1">
      <img src="/assets/brand/rosette-mini-dark.svg" alt="Collator" width="48" height="48" class="mb-4">
      <p class="text-parchment-dim text-sm leading-snug mb-3">A calm, private place for everything your family would need to find.</p>
      <p class="text-parchment-dim text-sm mb-4">Made with care by R41</p>
      <a href="{{ site.productHunt.href }}" target="_blank" rel="noopener" data-umami-event="Product Hunt badge click"><img src="{{ site.productHunt.badge }}" alt="Collator on Product Hunt" width="250" height="54" loading="lazy"></a>
      <a href="https://fazier.com" target="_blank" rel="noopener" class="inline-block mt-3"><img src="https://fazier.com/api/v1//public/badges/launch_badges.svg?badge_type=launched&theme=dark" alt="Launched on Fazier" width="120" loading="lazy"></a>
    </div>
    <div>
      <p class="text-parchment text-sm font-semibold mb-3">Features</p>
      <ul class="space-y-2">
        {% for f in features %}
        <li><a href="/{{ f.slug }}/" class="{% if activePage == f.slug %}text-parchment{% else %}text-parchment-dim hover:text-parchment{% endif %} text-sm transition-colors">{{ f.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <p class="text-parchment text-sm font-semibold mb-3">Legal</p>
      <ul class="space-y-2">
        <li><a href="/privacy" class="{% if activePage == 'privacy' %}text-parchment{% else %}text-parchment-dim hover:text-parchment{% endif %} text-sm transition-colors">Privacy policy</a></li>
        <li><a href="/terms" class="{% if activePage == 'terms' %}text-parchment{% else %}text-parchment-dim hover:text-parchment{% endif %} text-sm transition-colors">Terms of service</a></li>
      </ul>
    </div>
    <div>
      <p class="text-parchment text-sm font-semibold mb-3">Product</p>
      <ul class="space-y-2">
        <li><a href="/support" class="{% if activePage == 'support' %}text-parchment{% else %}text-parchment-dim hover:text-parchment{% endif %} text-sm transition-colors">Support</a></li>
        <li><a href="{{ site.userjot.feedback }}" target="_blank" rel="noopener" class="text-parchment-dim text-sm hover:text-parchment transition-colors">Feedback</a></li>
        <li><a href="{{ site.userjot.roadmap }}" target="_blank" rel="noopener" class="text-parchment-dim text-sm hover:text-parchment transition-colors">Roadmap</a></li>
        <li><a href="{{ site.userjot.changelog }}" target="_blank" rel="noopener" class="text-parchment-dim text-sm hover:text-parchment transition-colors">Changelog</a></li>
      </ul>
    </div>
    <div>
      <p class="text-parchment text-sm font-semibold mb-3">Get it</p>
      <ul class="space-y-2">
        <li><a href="{{ site.stores.appStore }}" data-umami-event="App Store click" class="text-parchment-dim text-sm hover:text-parchment transition-colors">App Store</a></li>
        <li><a href="{{ site.stores.googlePlay }}" data-umami-event="Google Play click" class="text-parchment-dim text-sm hover:text-parchment transition-colors">Google Play</a></li>
        {% for s in site.social %}
        <li><a href="{{ s.href }}" target="_blank" rel="noopener" class="text-parchment-dim text-sm hover:text-parchment transition-colors">{{ s.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</footer>
