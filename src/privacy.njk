          </li>
          <li class="flex items-start gap-3 text-[.9375rem] text-dim opacity-80">
            <span class="w-5 h-5 rounded-full bg-[#DCF0E8] text-[#1A5040] flex items-center justify-center shrink-0 mt-0.5">
              {% icon "check", "w-3 h-3" %}
            </span>
            App settings and preferences, such as theme and lock method
          </li>
        </ul>
      </div>

      <div class="bg-card border border-hair rounded-[14px] p-6 shadow-card">
        <h3 class="font-semibold text-[.875rem] text-ink mb-3">We never collect</h3>
        <ul class="space-y-2.5">
          <li class="flex items-start gap-3 text-[.9375rem] text-dim opacity-80">
            <span class="w-5 h-5 rounded-full bg-[#F8ECEC] text-[#943028] flex items-center justify-center shrink-0 mt-0.5">
